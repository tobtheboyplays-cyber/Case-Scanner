# Kopier denne til .env og fyll inn ved behov. .env committes ALDRI.

# Hvor SQLite-databasen lagres (default holder inne i data/).
CASE_RADAR_DB=data/case_radar.sqlite3

# Slå Google Trends av/på (kan rate-limites). true/false.
CASE_RADAR_ENABLE_TRENDS=true

# Google Calendar (valgfritt). Last ned OAuth-klient (Desktop) fra Google Cloud
# og legg filen her. Uten denne kjorer appen fint - bare uten live kalender.
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# --- KI-agenter (redaktor + journalist) ---
# Legg ÉN nøkkel HER paa serveren (aldri i chat/kode). Ingen nøkkel = demo-maler.
#
# GRATIS live-KI (anbefalt hvis du ikke vil betale): Google Gemini gratis-nivaa.
# Hent nøkkel paa https://aistudio.google.com/app/apikey (ingen kort). Sett:
# GEMINI_API_KEY=AI...
# CASE_RADAR_GEMINI_MODEL=gemini-2.0-flash   # gratis-nivaa, kan endres
#
# BETALT live-KI: Claude API (egen kreditt paa console.anthropic.com, IKKE et
# Claude-abonnement). Har du begge nøkler, brukes Claude.
# ANTHROPIC_API_KEY=sk-ant-...
CASE_RADAR_ENABLE_AI=true
CASE_RADAR_MODEL_FAST=claude-haiku-4-5      # analytiker + redaktor (kun Claude)
CASE_RADAR_MODEL_WRITER=claude-sonnet-5     # journalist (kun Claude)
CASE_RADAR_EDITOR_CAP=8                      # maks antall redaktor-vurderinger per skann
CASE_RADAR_JOURNALIST_CAP=6                  # maks antall utkast per skann

# Schibsted-soesteraviser (gjenbruks-ideer). true/false.
CASE_RADAR_ENABLE_SCHIBSTED=true
